rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function courseData(courseId) {
      return get(/databases/$(database)/documents/courses/$(courseId)).data;
    }

    function userData(uid) {
      return get(/databases/$(database)/documents/users/$(uid)).data;
    }

    function liveSessionData(sessionId) {
      return get(/databases/$(database)/documents/liveSessions/$(sessionId)).data;
    }

    // isAdmin() can never be self-granted client-side: 'admin' is never in the
    // role allowlist on `users` create below, and the only write path that can
    // set role: 'admin' on a user doc is another admin (or a human editing
    // Firestore directly in the Firebase Console, which bypasses rules). See
    // CLAUDE.md for how the first admin gets bootstrapped.
    function isAdmin() {
      return isSignedIn() && userData(request.auth.uid).role == 'admin';
    }

    // Grandfathers accounts written before the `status` field existed (treats
    // a missing status as approved) so pre-existing teachers don't get locked
    // out the moment this rule ships. Also false for any role once an admin
    // has set `disabled: true` on the account (see AdminUserRow's disable
    // toggle) — same "can't act on the platform" outcome as an unapproved
    // teacher, just admin-triggered instead of self-inflicted.
    function isApproved(uid) {
      let u = userData(uid);
      return (!('status' in u) || u.status == 'approved') && u.get('disabled', false) != true;
    }

    // The one account an admin can never demote, disable, or otherwise lock
    // themselves or another admin out of — eldesouky71@gmail.com. Kept as a
    // literal (rules can't read frontend/src/lib/constants.ts) so it has to
    // be updated in both places if it ever changes.
    function isProtectedAccount() {
      return resource.data.email == 'eldesouky71@gmail.com';
    }

    // --- users ---------------------------------------------------------
    match /users/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      // An admin creating a user directly (AdminAddUserForm) can hand out
      // any role, including 'admin' — but a teacher account still needs the
      // same pending -> approved review whether it was self-registered or
      // admin-created (createUserByAdmin sets status accordingly), so this
      // branch doesn't constrain `status` the way the self-registration one
      // does; it's just not the thing being guarded against here.
      allow create: if (isOwner(uid)
          && request.resource.data.role in ['teacher', 'student']
          && request.resource.data.status == (request.resource.data.role == 'teacher' ? 'pending' : 'approved'))
        || (isAdmin() && request.resource.data.role in ['teacher', 'student', 'admin']);
      // Nobody — not even another admin — can change the protected account's
      // email, role, or disabled flag through this rule; only a human editing
      // Firestore directly in the Firebase Console can. Everything else about
      // it (name, photo, personal details) stays normally admin-editable.
      //
      // xp/streakCount/lastActiveDate are self-reported client-side rewards
      // (see lib/firebase/users.ts awardLessonCompletionRewards(), called
      // after completeLesson()) — same "no Cloud Function to verify a real
      // lesson was completed" limitation as enrollments.completedLessonIds
      // above. The best available guard on Spark: xp/streakCount can only
      // move forward, and a single write can never grant more than one
      // lesson's worth of xp (10 below must stay equal to XP_PER_LESSON in
      // lib/firebase/users.ts). streakCount may only stay unchanged, go up
      // by exactly 1, or reset to exactly 1 (a legitimate streak-break reset
      // — a plain "non-decreasing" check would wrongly reject that). This
      // can't stop someone from calling completeLesson() once per real lesson
      // as fast as they can click through a course — same trade-off already
      // accepted for completedLessonIds padding.
      allow update: if (isOwner(uid)
          && request.resource.data.role == resource.data.role
          && request.resource.data.status == resource.data.status
          && request.resource.data.get('disabled', false) == resource.data.get('disabled', false)
          && request.resource.data.get('xp', 0) >= resource.data.get('xp', 0)
          && request.resource.data.get('xp', 0) - resource.data.get('xp', 0) <= 10
          && (request.resource.data.get('streakCount', 0) == resource.data.get('streakCount', 0)
              || request.resource.data.get('streakCount', 0) == resource.data.get('streakCount', 0) + 1
              || request.resource.data.get('streakCount', 0) == 1)
          && request.resource.data.get('lastActiveDate', '') >= resource.data.get('lastActiveDate', ''))
        || (isAdmin()
            && (!isProtectedAccount()
                || (request.resource.data.email == resource.data.email
                    && request.resource.data.role == resource.data.role
                    && request.resource.data.get('disabled', false) == resource.data.get('disabled', false))));
      // Only removes the users/{uid} doc — it can't touch the underlying
      // Firebase Auth account (needs the Admin SDK, see CLAUDE.md), and
      // deliberately doesn't cascade-delete the user's enrollments/certificates
      // (certificates are meant to stay valid/verifiable even if the earner's
      // account is later removed). AdminUserRow's delete button makes this
      // limitation explicit to the admin before they confirm.
      allow delete: if isAdmin() && !isProtectedAccount();

      // --- users/{uid}/activity/{date} — daily lesson-completion counter for
      // the student dashboard's weekly-activity chart (date = "YYYY-MM-DD").
      // Same delta-capped-self-write pattern as xp/streakCount above: a
      // write can only start a fresh day's doc at count == 1, or bump an
      // existing one by exactly 1 (one increment per completeLesson() call,
      // see incrementDailyActivity() in lib/firebase/users.ts). Never
      // decreases, never jumps by more than one lesson per write.
      match /activity/{date} {
        allow read: if isOwner(uid) || isAdmin();
        allow create: if isOwner(uid) && isApproved(uid) && request.resource.data.count == 1;
        allow update: if isOwner(uid) && isApproved(uid)
          && request.resource.data.count == resource.data.count + 1;
        allow delete: if false;
      }
    }

    // --- courses ---------------------------------------------------------
    match /courses/{courseId} {
      allow read: if resource.data.published == true
        || (isSignedIn() && request.auth.uid == resource.data.teacherId)
        || isAdmin();
      allow create: if isSignedIn()
        && request.resource.data.teacherId == request.auth.uid
        && request.resource.data.published == false
        && isApproved(request.auth.uid);
      allow update: if (isOwner(resource.data.teacherId)
          && request.resource.data.teacherId == resource.data.teacherId
          && isApproved(request.auth.uid))
        || isAdmin();
      // Only admin can delete a course outright — a teacher still can't
      // hard-delete their own (they can only unpublish it).
      allow delete: if isAdmin();

      match /lessons/{lessonId} {
        function course() {
          return get(/databases/$(database)/documents/courses/$(courseId)).data;
        }

        allow read: if course().published == true || isOwner(course().teacherId) || isAdmin();
        allow create: if isOwner(course().teacherId) && isApproved(request.auth.uid);
        allow update, delete: if (isOwner(course().teacherId) && isApproved(request.auth.uid)) || isAdmin();
      }
    }

    // --- enrollments (id = "{uid}_{courseId}") ----------------------------
    // No paid Cloud Functions on the free (Spark) plan, so these rules — not
    // server code — are what stop a student from handing themselves 100%
    // progress or a certificate for a course they never touched. It isn't
    // perfect (a determined user could still pad completedLessonIds with
    // made-up ids up to the real lesson count), but it enforces every check
    // that doesn't require iterating the lessons subcollection, which rules
    // can't do without a paid plan's Cloud Functions.
    match /enrollments/{enrollmentId} {
      allow read: if isOwner(resource.data.uid) || isAdmin();
      allow create: if isOwner(request.resource.data.uid)
        && isApproved(request.auth.uid)
        && enrollmentId == request.auth.uid + '_' + request.resource.data.courseId
        && request.resource.data.certificateIssued == false
        && request.resource.data.progress == 0;
      allow update: if isOwner(resource.data.uid)
        && isApproved(request.auth.uid)
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.courseId == resource.data.courseId
        && request.resource.data.progress >= resource.data.progress
        && request.resource.data.completedLessonIds.size() <= courseData(resource.data.courseId).lessonsCount
        && (request.resource.data.progress < 100
            || request.resource.data.completedLessonIds.size() >= courseData(resource.data.courseId).lessonsCount)
        // certificateIssued may only flip false -> true, never back
        && (request.resource.data.certificateIssued == resource.data.certificateIssued
            || request.resource.data.certificateIssued == true);
      allow delete: if false;
    }

    // --- certificates (id = "{uid}_{courseId}", same scheme as enrollments) --
    // Publicly readable so anyone can verify a certificate by its code.
    // A client can create its own certificate doc, but only one matching its
    // own completed enrollment, and only with names/titles copied from the
    // real course/user docs — it can't forge someone else's certificate or
    // put fake display text on its own.
    match /certificates/{certificateId} {
      function matchingEnrollment() {
        return get(/databases/$(database)/documents/enrollments/$(certificateId)).data;
      }

      allow read: if true;
      allow create: if isOwner(request.resource.data.uid)
        && certificateId == request.auth.uid + '_' + request.resource.data.courseId
        && matchingEnrollment().uid == request.auth.uid
        && matchingEnrollment().courseId == request.resource.data.courseId
        && matchingEnrollment().progress == 100
        && request.resource.data.courseTitle == courseData(request.resource.data.courseId).title
        && request.resource.data.teacherName == courseData(request.resource.data.courseId).teacherName
        && request.resource.data.studentName == userData(request.auth.uid).name;
      // Admin can correct a typo or revoke a fraudulently-issued certificate;
      // a client can still never create/update its own.
      allow update, delete: if isAdmin();
    }

    // --- reviews (id = "{uid}_{courseId}", same scheme as enrollments) -----
    // Publicly readable (course pages show ratings to signed-out visitors
    // too). A student can leave exactly one review per course, ever — no
    // update/delete path is exposed to a client at all, deliberately: this
    // project has no Cloud Function to verify a lesson was really watched
    // (see enrollments above), so an editable review would be an easy way to
    // launder a fabricated 100%-progress enrollment into a fake testimonial
    // after the fact. Course/teacher rating averages are computed by reading
    // every review for a course client-side (see lib/hooks/useCourseReviews.ts)
    // rather than kept as a running total on the course doc — Firestore
    // rules evaluate each document in a batch against the pre-batch state, so
    // a "ratingSum/ratingCount on Course" field could never be made to prove
    // a real review doc was written alongside it in the same write.
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isOwner(request.resource.data.uid)
        && reviewId == request.auth.uid + '_' + request.resource.data.courseId
        && request.resource.data.rating is int
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5
        && get(/databases/$(database)/documents/enrollments/$(reviewId)).data.uid == request.auth.uid
        && get(/databases/$(database)/documents/enrollments/$(reviewId)).data.courseId == request.resource.data.courseId
        && get(/databases/$(database)/documents/enrollments/$(reviewId)).data.progress == 100
        && request.resource.data.courseTitle == courseData(request.resource.data.courseId).title
        && request.resource.data.studentName == userData(request.auth.uid).name;
      allow update, delete: if isAdmin();
    }

    // --- questionBank (id = generated, owned by one teacher) ---------------
    // A teacher's private, reusable pool of MCQ questions — separate from
    // any lesson's or course's own quiz array, so a question can be authored
    // once and copied into several quizzes (see QuizBuilder.tsx's "import
    // from bank" picker). Never shared between teachers — same ownership
    // shape as `courses` (teacherId field + isApproved() gate), just with no
    // published/public-read state at all.
    match /questionBank/{questionId} {
      allow read: if isOwner(resource.data.teacherId) || isAdmin();
      allow create: if isSignedIn()
        && request.resource.data.teacherId == request.auth.uid
        && isApproved(request.auth.uid);
      allow update, delete: if (isOwner(resource.data.teacherId) && isApproved(request.auth.uid)) || isAdmin();
    }

    // --- liveSessions — whiteboard + chat + poll only, no real audio/video
    // (no WebRTC/Realtime Database infra on the free Spark plan, see
    // CLAUDE.md). Read access mirrors `courses`: visible if the parent
    // course is published, or the requester owns it, or is admin. A poll's
    // question/options/active flag/pollId live directly on the session doc
    // (only the owning teacher can write it, via this match block's own
    // update rule) rather than a separate collection — votes are still
    // their own subcollection so one-vote-per-student can be enforced by
    // the same doc-id-is-the-uid trick used for enrollments/certificates/
    // reviews above.
    match /liveSessions/{sessionId} {
      function sessionCourse() {
        return courseData(resource.data.courseId);
      }

      allow read: if isSignedIn()
        && (sessionCourse().published == true || isOwner(sessionCourse().teacherId) || isAdmin());
      allow create: if isOwner(request.resource.data.teacherId)
        && isApproved(request.auth.uid)
        && courseData(request.resource.data.courseId).teacherId == request.auth.uid
        && request.resource.data.status == 'scheduled';
      allow update: if (isOwner(resource.data.teacherId) && isApproved(request.auth.uid)) || isAdmin();
      // Can't delete a session that's currently live — end it first.
      allow delete: if (isOwner(resource.data.teacherId) && isApproved(request.auth.uid) && resource.data.status != 'live')
        || isAdmin();

      // Chat — create-only while the session is live; immutable once sent
      // (no update path, same as reviews); teacher/admin can delete a
      // message for moderation.
      match /messages/{messageId} {
        allow read: if isSignedIn();
        allow create: if isOwner(request.resource.data.uid)
          && isApproved(request.auth.uid)
          && liveSessionData(sessionId).status == 'live'
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 500;
        allow update: if false;
        allow delete: if isOwner(liveSessionData(sessionId).teacherId) || isAdmin();
      }

      // Presence + hand-raise — doc id is the participant's own uid, so a
      // student can only ever write their own participant doc; the teacher
      // can remove one (kick) via the delete branch below. Presence here is
      // heartbeat-based (see useLiveParticipants.ts), not real disconnect
      // detection — that needs Realtime Database's onDisconnect(), which
      // this project doesn't use.
      match /participants/{uid} {
        allow read: if isSignedIn();
        allow create, update: if isOwner(uid) && isApproved(uid) && liveSessionData(sessionId).status == 'live';
        allow delete: if isOwner(uid) || isOwner(liveSessionData(sessionId).teacherId) || isAdmin();
      }

      // Whiteboard strokes — teacher-only writes (one drawer, not a
      // multi-writer CRDT problem). One immutable doc per stroke, written
      // once on pointer-up, never per point. "Clear" updates
      // whiteboardClearedAt on the session doc itself (already covered by
      // the update rule above) instead of deleting every stroke doc —
      // viewers just filter createdAt > whiteboardClearedAt client-side.
      match /strokes/{strokeId} {
        allow read: if isSignedIn();
        allow create: if isOwner(liveSessionData(sessionId).teacherId)
          && isApproved(request.auth.uid)
          && liveSessionData(sessionId).status == 'live';
        allow update, delete: if false;
      }

      // One vote per student per poll instance — doc id = uid. pollId
      // (regenerated by the teacher each time a new poll is opened) has to
      // match the session's *current* poll, so a leftover vote doc from an
      // earlier poll in the same session just stops counting instead of
      // needing to be deleted.
      match /pollVotes/{uid} {
        allow read: if isSignedIn();
        allow create, update: if isOwner(uid)
          && isApproved(uid)
          && liveSessionData(sessionId).get('poll', {}).get('active', false) == true
          && request.resource.data.pollId == liveSessionData(sessionId).get('poll', {}).get('pollId', '');
        allow delete: if false;
      }
    }

    // --- adminAuditLog (append-only, admin-only) --------------------------
    match /adminAuditLog/{entryId} {
      allow read: if isAdmin();
      allow create: if isAdmin() && request.resource.data.adminUid == request.auth.uid;
      allow update, delete: if false;
    }

    // --- stageSubjects/{stageId} — admin-editable override of the static,
    // per-stage subject list (see data/stages.ts / messages/*.json). Publicly
    // readable since course creation/browsing needs it for every visitor.
    match /stageSubjects/{stageId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
