  },
  "features": {
    "eyebrow": "Teacher Dashboard",
    "title": "Everything a teacher needs, in one place",
    "description": "From the first lesson you publish to the last certificate you issue, with tools built to save your time.",
    "items": [
      { "title": "Video & File Lessons", "desc": "Upload your lessons as video or PDF, organized into units and chapters." },
      { "title": "Complete Curricula", "desc": "Build a full curriculum in clear order, from the first lesson to the last unit." },
      { "title": "Question Bank & Quizzes", "desc": "Multiple-choice questions with instant automatic grading." },
      { "title": "Verified Digital Certificates", "desc": "A certificate for every student with a unique code anyone can verify." },
      { "title": "Live Analytics", "desc": "Track every student's progress, completion rates, and average scores." },
      { "title": "Direct Communication", "desc": "Student questions reach the teacher directly." }
    ]
  },
